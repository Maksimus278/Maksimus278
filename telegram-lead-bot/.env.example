# Create a bot with @BotFather, then paste the token here
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty (or set *) to auto-claim the first person who messages /start.
# Get your id from @userinfobot if you want to lock it manually.
TELEGRAM_ALLOWED_USER_IDS=

# Comma-separated Telegram usernames (with or without @)
TELEGRAM_ALLOWED_USERNAMES=mixerius

# Path to leads CSV (default: data/fleetguard-leads.csv)
LEADS_CSV_PATH=data/fleetguard-leads.csv

# SQLite file for contact / follow-up tracking
LEADS_DB_PATH=data/leads_state.db

# Default follow-up delay in days when you tap 📅 Follow Up
FOLLOWUP_DAYS=3